# Phase 0 local development. Copy to `.env` (gitignored).
# SYNTHETIC DATA ONLY — no real candidate PII until a DPA + US-region hosting +
# envelope encryption are confirmed (see docs/DECISIONS.md D8).

# FastAPI service (services/api)
API_HOST=0.0.0.0
API_PORT=8000

# BFF → FastAPI base URL (web/lib/api)
FASTAPI_BASE_URL=http://localhost:8000

# Database (WP 0.2). The app connects as the non-BYPASSRLS role `manfriday_app`;
# Alembic connects as the superuser/owner (defaults to your OS user over trust).
DATABASE_URL=postgresql+psycopg://manfriday_app@localhost:5432/manfriday_dev
# DATABASE_ADMIN_URL=postgresql+psycopg://<your-os-user>@localhost:5432/manfriday_dev

# Object storage (WP 0.6). Dev/CI = local filesystem; cloud = S3 (SSE-KMS).
STORAGE_DIR=/tmp/manfriday-object-store

# ── Wired in later work packages — placeholders only today ───
# REDIS_URL=redis://localhost:6379/0                    # WP 0.11 (Arq queue/cache)
# AWS_REGION=us-east-1                                  # WP 0.7  (KMS envelope encryption)
# SESSION_SECRET=...                                    # WP 0.10 (BFF encrypted session)
# JWT_SIGNING_KEY=...                                   # WP 0.10 (EdDSA internal JWT)
