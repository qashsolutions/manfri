# Copy to .env.local for local dev. Server-only vars (no NEXT_PUBLIC_ prefix).

# Where the UI reads its data from:
#   mock  → synthetic fixtures in lib/sample-data.ts (default; dev/staging/preview)
#   api   → real FastAPI/Supabase data (production)
# Keep "mock" everywhere except production. In "api" mode the data pages render
# dynamically (force-dynamic), so nothing is prerendered against a live backend.
DATA_SOURCE=mock

# Base URL for the FastAPI backend (only used when DATA_SOURCE=api).
# API_BASE_URL=http://localhost:8000

# --- Required only when DATA_SOURCE=api (production) ---
# The BFF mints a 5-min EdDSA internal JWT per request from the user's session and
# calls FastAPI with it; the browser never holds this token. PEM PKCS#8 private key
# (its public half is published via JWKS for FastAPI to verify). Store in a secret manager.
# BFF_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Encrypts the HttpOnly iron-session cookie (>= 32 chars). Rotate from a secret.
# SESSION_SECRET=change-me-to-a-long-random-value-min-32-chars
