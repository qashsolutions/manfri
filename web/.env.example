# Copy to .env.local for local dev. Server-only vars (no NEXT_PUBLIC_ prefix).

# Where the UI reads its data from:
#   mock  → synthetic fixtures in lib/sample-data.ts (default; dev/staging/preview)
#   api   → real Supabase-backed TS data (the /api/v1/* route handlers)
# Keep "mock" everywhere except where you're exercising the real backend. In "api"
# mode the data pages render dynamically (force-dynamic).
DATA_SOURCE=mock

# --- TS-on-Supabase backend (DATA_SOURCE=api) ---
# Supabase Postgres connection as the RLS-subject app role. Read by @manfriday/db; the
# /api/v1/* route handlers set the org_id JWT claim per request so RLS scopes queries.
# DATABASE_URL=postgresql://manfriday_authenticated:devpass@127.0.0.1:5432/manfriday_dev

# Base URL the server uses to call its own route handlers (defaults to
# http://localhost:3000, or https://$VERCEL_URL on Vercel).
# APP_BASE_URL=http://localhost:3000

# DEV ONLY — org resolution before the Supabase Auth UI is wired. Honored only when
# NODE_ENV != production OR ALLOW_DEV_ORG_HEADER=1. Production resolves the org from
# the Supabase Auth session (org_id JWT claim from custom_access_token_hook).
# ALLOW_DEV_ORG_HEADER=1
# DEV_ORG_ID=00000000-0000-0000-0000-00000000a000

# --- LLM (Vercel AI SDK → Google Gemini). Optional. ---
# Without a key: the deterministic fallback generates the 5/5/5 screening questions and
# the optional LLM authenticity pass is skipped (the deterministic checks always run).
# GOOGLE_GENERATIVE_AI_API_KEY=          # Google AI Studio key (or GEMINI_API_KEY)
# AI_MODEL_CAPABLE=gemini-3-flash-preview  # recruiter-facing question generation
# AI_MODEL_FAST=gemini-3.1-flash-lite      # cheap authenticity pass
# AI_AUTHENTICITY=1                      # enable the optional LLM authenticity pass (off by default)
# AI_TIMEOUT_MS=30000
