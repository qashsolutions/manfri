# @manfriday/db — connection strings. Scripts read these from the environment
# (no dotenv auto-load); export them or pass inline.

# RLS-subject app-role connection (the app + isolation test use this). On Supabase
# this is a connection as a non-superuser role that RLS applies to; locally it is the
# manfriday_authenticated role created by the baseline migration.
DATABASE_URL=postgresql://manfriday_authenticated:devpass@127.0.0.1:5432/manfriday_dev

# Owner/superuser connection used ONLY by migrate + seed (CREATE ROLE/EXTENSION,
# cross-org seed writes that bypass RLS). On Supabase this is the service/owner role.
DATABASE_URL_ADMIN=postgresql://postgres@127.0.0.1:5432/manfriday_dev
